<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="BK BIM Tools - Master Filter" Width="1060" Height="780"
        MinWidth="900" MinHeight="650" WindowStartupLocation="CenterScreen"
        Background="{StaticResource Surface.Base}" FontFamily="Segoe UI">
    <Window.Resources>
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource Text.Primary}"/>
        </Style>
        <Style TargetType="Button">
            <Setter Property="Padding" Value="14,7"/>
            <Setter Property="Margin" Value="6,0,0,0"/>
        </Style>
        <Style TargetType="ListBox">
            <Setter Property="Background" Value="{StaticResource Surface.Raised}"/>
            <Setter Property="Foreground" Value="{StaticResource Text.Primary}"/>
            <Setter Property="BorderBrush" Value="{StaticResource Border.Default}"/>
        </Style>
    </Window.Resources>
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
            <RowDefinition Height="160"/><RowDefinition Height="Auto"/>
            <RowDefinition Height="90"/><RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/><RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <StackPanel>
            <TextBlock Text="BK BIM TOOLS / UTILITIES" FontSize="11"/>
            <TextBlock Text="Master Filter" FontSize="26" FontWeight="SemiBold" Margin="0,4,0,4"/>
            <TextBlock Text="Find placed elements in this project. Empty lists include all values; text rules ignore case."/>
        </StackPanel>
        <DockPanel Grid.Row="1" Margin="0,16,0,12">
            <TextBlock Text="Scope" VerticalAlignment="Center" Margin="0,0,12,0"/>
            <ComboBox x:Name="ScopeCombo" Width="190" HorizontalAlignment="Left"/>
            <TextBlock Text="Category narrows family, type and level. Ctrl / Shift selects multiple values." VerticalAlignment="Center" Margin="16,0,0,0"/>
        </DockPanel>
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
            <DockPanel Margin="0,0,8,0"><TextBlock DockPanel.Dock="Top" Text="Category" Margin="0,0,0,6"/><ListBox x:Name="CategoryList" SelectionMode="Extended"/></DockPanel>
            <DockPanel Grid.Column="1" Margin="0,0,8,0"><TextBlock DockPanel.Dock="Top" Text="Family" Margin="0,0,0,6"/><ListBox x:Name="FamilyList" SelectionMode="Extended"/></DockPanel>
            <DockPanel Grid.Column="2" Margin="0,0,8,0"><TextBlock DockPanel.Dock="Top" Text="Type" Margin="0,0,0,6"/><ListBox x:Name="TypeList" SelectionMode="Extended"/></DockPanel>
            <DockPanel Grid.Column="3"><TextBlock DockPanel.Dock="Top" Text="Level" Margin="0,0,0,6"/><ListBox x:Name="LevelList" SelectionMode="Extended"/></DockPanel>
        </Grid>
        <StackPanel Grid.Row="3" Margin="0,12,0,8">
            <TextBlock Text="Parameter rules (instance and type parameters are separate)" Margin="0,0,0,6"/>
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="2*"/><ColumnDefinition/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <ComboBox x:Name="ParameterCombo" Margin="0,0,8,0"/>
                <ComboBox x:Name="OperatorCombo" Grid.Column="1" Margin="0,0,8,0"/>
                <TextBox x:Name="ValueBox" Grid.Column="2" Height="28" Padding="6,3" ToolTip="Text, or a number in project display units without a unit suffix"/>
                <Button x:Name="AddRuleButton" Grid.Column="3" Content="Add rule"/>
            </Grid>
            <TextBlock Text="Numeric comparisons use project display units. Missing parameters never match a rule." FontSize="11" Margin="0,5,0,0"/>
        </StackPanel>
        <DockPanel Grid.Row="4">
            <StackPanel DockPanel.Dock="Right" Margin="8,0,0,0">
                <ComboBox x:Name="ModeCombo" Width="140"/>
                <Button x:Name="RemoveRuleButton" Content="Remove rule" Margin="0,8,0,0"/>
            </StackPanel>
            <ListBox x:Name="RulesList"/>
        </DockPanel>
        <DockPanel Grid.Row="5" Margin="0,12,0,8">
            <Button x:Name="PreviewButton" DockPanel.Dock="Right" Content="Preview matches"/>
            <Button x:Name="ClearButton" DockPanel.Dock="Right" Content="Clear filters"/>
            <TextBlock x:Name="CountText" VerticalAlignment="Center" FontWeight="SemiBold"/>
        </DockPanel>
        <ListBox x:Name="PreviewList" Grid.Row="6" FontFamily="Consolas" FontSize="11"/>
        <TextBlock x:Name="StatusText" Grid.Row="7" Margin="0,8,0,8" TextWrapping="Wrap"/>
        <StackPanel Grid.Row="8" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button x:Name="CancelButton" Content="Cancel" IsCancel="True"/>
            <Button x:Name="ShowButton" Content="Show in Revit"/>
            <Button x:Name="IsolateButton" Content="Temporarily isolate"/>
            <Button x:Name="SelectButton" Content="Select matches" Background="{StaticResource Brand.Primary}" Foreground="White"/>
        </StackPanel>
    </Grid>
</Window>
