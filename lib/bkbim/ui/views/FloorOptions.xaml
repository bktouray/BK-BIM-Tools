<Window
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="BK BIM Tools - Floor Options"
    Width="440"
    SizeToContent="Height"
    MinWidth="400" MinHeight="360"
    WindowStartupLocation="CenterScreen"
    ResizeMode="CanResizeWithGrip"
    Background="{StaticResource Surface.Base}"
    FontFamily="Segoe UI">

    <!-- Color brushes (Brand.Primary etc.) come from the shared
         ui/themes/Tokens.xaml, merged in code-behind before this file is
         parsed - see bkbim/ui/tokens.py. -->
    <Window.Resources>
        <Style TargetType="TextBlock" x:Key="Caption">
            <Setter Property="Foreground" Value="{StaticResource Text.Secondary}"/>
            <Setter Property="FontSize" Value="11"/>
        </Style>
        <Style TargetType="Label">
            <Setter Property="Foreground" Value="{StaticResource Text.Primary}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Padding" Value="0,0,0,4"/>
        </Style>
        <Style TargetType="Button">
            <Setter Property="Padding" Value="16,6"/>
            <Setter Property="Margin" Value="8,0,0,0"/>
            <Setter Property="Background" Value="{StaticResource Surface.Raised}"/>
            <Setter Property="BorderBrush" Value="{StaticResource Border.Default}"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>
    </Window.Resources>

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0">
            <TextBlock Text="BK BIM TOOLS" Style="{StaticResource Caption}" FontWeight="SemiBold"/>
            <TextBlock x:Name="TitleText" Text="Floor Options" FontSize="18" FontWeight="SemiBold"
                       Foreground="{StaticResource Text.Primary}" Margin="0,2,0,4"/>
            <TextBlock x:Name="SubtitleText"
                       Text="Create floors from closed slab outlines on the selected CAD layer."
                       Style="{StaticResource Caption}" TextWrapping="Wrap"/>
        </StackPanel>

        <Separator Grid.Row="1" Margin="0,16,0,0"/>

        <!-- Floor type -->
        <StackPanel Grid.Row="2" Margin="0,16,0,0">
            <Label Content="Floor type"/>
            <ComboBox x:Name="FloorTypeCombo" Height="28"/>
        </StackPanel>

        <!-- Level -->
        <StackPanel Grid.Row="3" Margin="0,12,0,0">
            <Label Content="Level"/>
            <ComboBox x:Name="LevelCombo" Height="28"/>
        </StackPanel>

        <!-- Boundary mode -->
        <StackPanel Grid.Row="4" Margin="0,12,0,0">
            <Label Content="Floor boundary"/>
            <RadioButton x:Name="TotalBoundaryRadio" Content="Total CAD boundary"
                         GroupName="FloorBoundary" IsChecked="True" Margin="0,0,0,4"/>
            <RadioButton x:Name="WallsBoundaryRadio" Content="Draw around walls (core face)"
                         GroupName="FloorBoundary"/>
        </StackPanel>

        <!-- Height offset -->
        <StackPanel Grid.Row="5" Margin="0,12,0,0">
            <Label Content="Height offset from level (mm)"/>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="70"/>
                </Grid.ColumnDefinitions>
                <Slider x:Name="OffsetSlider" Grid.Column="0" Minimum="-3000" Maximum="3000"
                        VerticalAlignment="Center" Margin="0,0,12,0"/>
                <TextBox x:Name="OffsetTextBox" Grid.Column="1" Height="26"
                         VerticalContentAlignment="Center" TextAlignment="Right"/>
            </Grid>
        </StackPanel>

        <!-- Row 6 ("*") intentionally empty: absorbs extra vertical space so the
             footer stays anchored near the bottom instead of floating mid-window
             when the user resizes taller. -->

        <!-- Footer -->
        <StackPanel Grid.Row="7" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button x:Name="CancelButton" Content="Cancel" IsCancel="True"/>
            <Button x:Name="RunButton" Content="Run" IsDefault="True"
                    Background="{StaticResource Brand.Primary}" Foreground="White" BorderThickness="0"/>
        </StackPanel>
    </Grid>
</Window>
