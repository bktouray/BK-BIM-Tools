<Window
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="BK BIM Tools - Wall &amp; Opening Dimensions"
    Width="460"
    Height="640"
    MinWidth="400" MinHeight="500"
    WindowStartupLocation="CenterScreen"
    ResizeMode="CanResizeWithGrip"
    Background="{StaticResource Surface.Base}"
    FontFamily="Segoe UI">

    <!-- Color brushes (Brand.Primary etc.) come from the shared
         ui/themes/Tokens.xaml, merged in code-behind before this file is
         parsed - see bkbim/ui/tokens.py. -->
    <Window.Resources>
        <Style TargetType="TextBlock" x:Key="Caption">
            <Setter Property="Foreground" Value="{StaticResource Text.Secondary}"/>
            <Setter Property="FontSize" Value="11"/>
        </Style>
        <Style TargetType="Label">
            <Setter Property="Foreground" Value="{StaticResource Text.Primary}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Padding" Value="0,0,0,4"/>
        </Style>
        <Style TargetType="Button">
            <Setter Property="Padding" Value="16,6"/>
            <Setter Property="Margin" Value="8,0,0,0"/>
            <Setter Property="Background" Value="{StaticResource Surface.Raised}"/>
            <Setter Property="BorderBrush" Value="{StaticResource Border.Default}"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>
    </Window.Resources>

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0">
            <TextBlock Text="BK BIM TOOLS" Style="{StaticResource Caption}" FontWeight="SemiBold"/>
            <TextBlock Text="Wall &amp; Opening Dimensions" FontSize="18" FontWeight="SemiBold"
                       Foreground="{StaticResource Text.Primary}" Margin="0,2,0,4"/>
            <TextBlock Text="Dimensions every wall detected in the current view, end to end, broken at each door/window jamb and every crossing wall."
                       Style="{StaticResource Caption}" TextWrapping="Wrap"/>
        </StackPanel>

        <Separator Grid.Row="1" Margin="0,16,0,0"/>

        <!-- Dimension style -->
        <StackPanel Grid.Row="2" Margin="0,16,0,0">
            <Label Content="Dimension style"/>
            <ComboBox x:Name="DimensionStyleCombo" Height="28"/>
        </StackPanel>

        <!-- Offset spacing -->
        <StackPanel Grid.Row="3" Margin="0,12,0,0">
            <Label Content="Offset from wall (mm)"/>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="70"/>
                </Grid.ColumnDefinitions>
                <Slider x:Name="OffsetSlider" Grid.Column="0" Minimum="0" Maximum="3000"
                        VerticalAlignment="Center" Margin="0,0,12,0"/>
                <TextBox x:Name="OffsetTextBox" Grid.Column="1" Height="26"
                         VerticalContentAlignment="Center" TextAlignment="Right"/>
            </Grid>
        </StackPanel>

        <!-- Gap between the 3 exterior perimeter strings -->
        <StackPanel Grid.Row="4" Margin="0,12,0,0">
            <Label Content="Gap between exterior perimeter strings (mm)"/>
            <TextBlock Text="Only matters for walls you select as exterior after clicking Run - each of the 3 strings sits this far past the last one."
                       Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,0,0,6"/>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="70"/>
                </Grid.ColumnDefinitions>
                <Slider x:Name="GapSlider" Grid.Column="0" Minimum="300" Maximum="3000"
                        VerticalAlignment="Center" Margin="0,0,12,0"/>
                <TextBox x:Name="GapTextBox" Grid.Column="1" Height="26"
                         VerticalContentAlignment="Center" TextAlignment="Right"/>
            </Grid>
        </StackPanel>

        <!-- Wall types to use for dimensions -->
        <Grid Grid.Row="5" Margin="0,12,0,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <Label Grid.Row="0" Content="Wall types to dimension"/>
            <TextBlock Grid.Row="1" Text="Modeling each layer as its own wall? Pick only the structural/core type(s) here - other layers (plaster, tile, ...) are ignored entirely, including as crossing walls."
                       Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,0,0,6"/>
            <ListBox x:Name="WallTypesList" Grid.Row="2" MinHeight="110" SelectionMode="Extended"/>
        </Grid>

        <!-- Footer -->
        <StackPanel Grid.Row="6" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button x:Name="CancelButton" Content="Cancel" IsCancel="True"/>
            <Button x:Name="RunButton" Content="Run" IsDefault="True"
                    Background="{StaticResource Brand.Primary}" Foreground="White" BorderThickness="0"/>
        </StackPanel>
    </Grid>
</Window>
