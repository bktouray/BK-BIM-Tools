<Window
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="BK BIM Tools - Wall Options"
    Width="480"
    SizeToContent="Height"
    MinWidth="420" MinHeight="420"
    WindowStartupLocation="CenterScreen"
    ResizeMode="CanResizeWithGrip"
    Background="{StaticResource Surface.Base}"
    FontFamily="Segoe UI">

    <!-- Color brushes (Brand.Primary etc.) come from the shared
         ui/themes/Tokens.xaml, merged in code-behind before this file is
         parsed - see bkbim/ui/tokens.py. One XAML file covers BOTH drawing
         modes (parallel double-line / centreline) - the chrome (header,
         levels, structural checkbox, footer) is identical, only the middle
         content's visibility toggles in code-behind based on which mode the
         pre-scan picker chose, same technique structural_dimension_options.py
         uses for per-category personalization. -->
    <Window.Resources>
        <Style TargetType="TextBlock" x:Key="Caption">
            <Setter Property="Foreground" Value="{StaticResource Text.Secondary}"/>
            <Setter Property="FontSize" Value="11"/>
        </Style>
        <Style TargetType="Label">
            <Setter Property="Foreground" Value="{StaticResource Text.Primary}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Padding" Value="0,0,0,4"/>
        </Style>
        <Style TargetType="Button">
            <Setter Property="Padding" Value="16,6"/>
            <Setter Property="Margin" Value="8,0,0,0"/>
            <Setter Property="Background" Value="{StaticResource Surface.Raised}"/>
            <Setter Property="BorderBrush" Value="{StaticResource Border.Default}"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>
    </Window.Resources>

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0">
            <TextBlock Text="BK BIM TOOLS" Style="{StaticResource Caption}" FontWeight="SemiBold"/>
            <TextBlock x:Name="TitleText" Text="Wall Options" FontSize="18" FontWeight="SemiBold"
                       Foreground="{StaticResource Text.Primary}" Margin="0,2,0,4"/>
            <TextBlock x:Name="SubtitleText"
                       Text="Detected walls - confirm the levels and map each thickness to a wall type."
                       Style="{StaticResource Caption}" TextWrapping="Wrap"/>
        </StackPanel>

        <Separator Grid.Row="1" Margin="0,16,0,0"/>

        <!-- Levels -->
        <StackPanel Grid.Row="2" Margin="0,16,0,0">
            <Label Content="Start Level (base)"/>
            <ComboBox x:Name="StartLevelCombo" Height="28"/>
        </StackPanel>

        <StackPanel Grid.Row="3" Margin="0,12,0,0">
            <Label Content="Stop Level (top)"/>
            <ComboBox x:Name="StopLevelCombo" Height="28"/>
        </StackPanel>

        <!-- Structural -->
        <StackPanel Grid.Row="4" Margin="0,12,0,0">
            <CheckBox x:Name="StructuralCheckBox" Content="Structural wall"/>
        </StackPanel>

        <!-- Mode-specific content: only one of these two panels is visible,
             toggled in code-behind based on the drawing mode chosen before
             this window opened. -->
        <Grid Grid.Row="5" Margin="0,12,0,0">
            <StackPanel x:Name="ParallelPanel">
                <Label Content="The two parallel lines represent the wall's:"/>
                <RadioButton x:Name="FinishFacesRadio" Content="Finish faces"
                             GroupName="WallFaceMode" IsChecked="True" Margin="0,0,0,4"/>
                <RadioButton x:Name="CoreFacesRadio" Content="Core faces"
                             GroupName="WallFaceMode" Margin="0,0,0,8"/>

                <Label Content="Base wall type (used when a thickness below is set to Auto-generate)"/>
                <Grid Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="90"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="BaseWallTypeText" Grid.Column="0" Text="(no base type chosen)"
                               VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                    <Button x:Name="ChooseBaseWallTypeButton" Grid.Column="1" Content="Choose…" Margin="0"/>
                </Grid>

                <Label Content="Material"/>
                <ComboBox x:Name="MaterialCombo" Height="28" Margin="0,0,0,8"/>

                <Label Content="Thickness groups"/>
                <TextBlock Text="Map each detected wall thickness to an existing wall type, or leave it set to Auto-generate to size the base type above to that thickness."
                           Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,0,0,6"/>
                <ScrollViewer Height="180" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel x:Name="ThicknessGroupsPanel"/>
                </ScrollViewer>
            </StackPanel>

            <StackPanel x:Name="CentrelinePanel">
                <Label Content="Wall type (used for every centreline)"/>
                <ComboBox x:Name="CentrelineWallTypeCombo" Height="28"/>
            </StackPanel>
        </Grid>

        <!-- Row 6 ("*") intentionally empty: absorbs extra vertical space so the
             footer stays anchored near the bottom instead of floating mid-window
             when the user resizes taller. -->

        <!-- Footer -->
        <StackPanel Grid.Row="7" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button x:Name="CancelButton" Content="Cancel" IsCancel="True"/>
            <Button x:Name="RunButton" Content="Run" IsDefault="True"
                    Background="{StaticResource Brand.Primary}" Foreground="White" BorderThickness="0"/>
        </StackPanel>
    </Grid>
</Window>
