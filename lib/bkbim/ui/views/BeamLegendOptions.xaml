<Window
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="BK BIM Tools - Beam Legend"
    Width="500"
    SizeToContent="Height"
    MinWidth="440" MinHeight="590"
    WindowStartupLocation="CenterScreen"
    ResizeMode="CanResizeWithGrip"
    Background="{StaticResource Surface.Base}"
    FontFamily="Segoe UI">

    <Window.Resources>
        <Style TargetType="TextBlock" x:Key="Caption">
            <Setter Property="Foreground" Value="{StaticResource Text.Secondary}"/>
            <Setter Property="FontSize" Value="11"/>
        </Style>
        <Style TargetType="Label">
            <Setter Property="Foreground" Value="{StaticResource Text.Primary}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Padding" Value="0,0,0,4"/>
        </Style>
        <Style TargetType="RadioButton">
            <Setter Property="Foreground" Value="{StaticResource Text.Primary}"/>
            <Setter Property="Margin" Value="0,0,0,6"/>
        </Style>
        <Style x:Key="SecondaryButton" TargetType="Button">
            <Setter Property="Padding" Value="16,6"/>
            <Setter Property="Margin" Value="8,0,0,0"/>
            <Setter Property="Background" Value="{StaticResource Surface.Raised}"/>
            <Setter Property="BorderBrush" Value="{StaticResource Border.Default}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Foreground" Value="{StaticResource Text.Primary}"/>
        </Style>
        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="Padding" Value="16,6"/>
            <Setter Property="Margin" Value="8,0,0,0"/>
            <Setter Property="Background" Value="{StaticResource Brand.Primary}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
        </Style>
    </Window.Resources>

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0">
            <TextBlock Text="BK BIM TOOLS" Style="{StaticResource Caption}" FontWeight="SemiBold"/>
            <TextBlock Text="Beam Legend" FontSize="18" FontWeight="SemiBold"
                       Foreground="{StaticResource Text.Primary}" Margin="0,2,0,4"/>
            <TextBlock Text="Builds a beam mark legend using the selected view filters."
                       Style="{StaticResource Caption}" TextWrapping="Wrap"/>
        </StackPanel>

        <Separator Grid.Row="1" Margin="0,16,0,16"/>

        <StackPanel Grid.Row="2">
            <Label Content="Beam marks come from"/>
            <RadioButton x:Name="ProjectScopeRadio" Content="Whole project" GroupName="Scope"/>
            <RadioButton x:Name="ViewScopeRadio" Content="Selected source view only" GroupName="Scope"/>
        </StackPanel>

        <StackPanel Grid.Row="3" Margin="0,8,0,0">
            <Label Content="Source view with beam filters"/>
            <ComboBox x:Name="SourceViewCombo" Height="28"/>
            <TextBlock Text="The tool reads this view, or its view template, for the beam mark line colours."
                       Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,4,0,0"/>
        </StackPanel>

        <StackPanel Grid.Row="4" Margin="0,12,0,0">
            <Label Content="Legend view to rebuild"/>
            <ComboBox x:Name="LegendViewCombo" Height="28"/>
            <TextBlock Text="The legend needs one seed beam Legend Component already placed."
                       Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,4,0,0"/>
        </StackPanel>

        <Separator Grid.Row="5" Margin="0,16,0,0"/>

        <StackPanel Grid.Row="6" Margin="0,16,0,0">
            <Label Content="Title text type"/>
            <ComboBox x:Name="TitleTypeCombo" Height="28"/>
        </StackPanel>

        <StackPanel Grid.Row="7" Margin="0,12,0,0">
            <Label Content="Label text type"/>
            <ComboBox x:Name="LabelTypeCombo" Height="28"/>
        </StackPanel>

        <StackPanel Grid.Row="8" Margin="0,12,0,0">
            <Label Content="Legend title"/>
            <TextBox x:Name="TitleTextBox" Height="26" VerticalContentAlignment="Center" Padding="6,0"/>
        </StackPanel>

        <StackPanel Grid.Row="9" Margin="0,14,0,0">
            <Label Content="Spacing"/>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock Text="Rows, mm" Style="{StaticResource Caption}"/>
                    <TextBox x:Name="RowSpacingTextBox" Height="26" VerticalContentAlignment="Center" Padding="6,0"/>
                </StackPanel>
                <StackPanel Grid.Column="2">
                    <TextBlock Text="Mark to component, mm" Style="{StaticResource Caption}"/>
                    <TextBox x:Name="MarkComponentTextBox" Height="26" VerticalContentAlignment="Center" Padding="6,0"/>
                </StackPanel>
                <StackPanel Grid.Column="4">
                    <TextBlock Text="Component to size, mm" Style="{StaticResource Caption}"/>
                    <TextBox x:Name="ComponentSizeTextBox" Height="26" VerticalContentAlignment="Center" Padding="6,0"/>
                </StackPanel>
            </Grid>
        </StackPanel>

        <TextBlock x:Name="ValidationText" Grid.Row="10" Style="{StaticResource Caption}"
                   TextWrapping="Wrap" Margin="0,10,0,0" Visibility="Collapsed"/>

        <StackPanel Grid.Row="11" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button x:Name="CancelButton" Content="Cancel" IsCancel="True" Style="{StaticResource SecondaryButton}" Margin="0"/>
            <Button x:Name="RunButton" Content="Generate" IsDefault="True" Style="{StaticResource PrimaryButton}"/>
        </StackPanel>
    </Grid>
</Window>

