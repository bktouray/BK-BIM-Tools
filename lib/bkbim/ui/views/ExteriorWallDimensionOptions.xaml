<Window
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="BK BIM Tools - Exterior Wall Dimension"
    Width="460"
    SizeToContent="Height"
    MinWidth="400" MinHeight="260"
    WindowStartupLocation="CenterScreen"
    ResizeMode="CanResizeWithGrip"
    Background="#FFFFFF"
    FontFamily="Segoe UI">

    <!-- Inline tokens for this window (UX_SPEC.md Sec 2), matching
         WallOpeningDimensionOptions.xaml. Migrate both to a shared
         ui/themes/Tokens.xaml once a third window needs the same values
         (ADR-0002). -->
    <Window.Resources>
        <SolidColorBrush x:Key="Brand.Primary" Color="#1A56DB"/>
        <SolidColorBrush x:Key="Text.Primary" Color="#111417"/>
        <SolidColorBrush x:Key="Text.Secondary" Color="#5B6572"/>
        <SolidColorBrush x:Key="Surface.Raised" Color="#F7F8FA"/>
        <SolidColorBrush x:Key="Border.Default" Color="#DFE3E8"/>

        <Style TargetType="TextBlock" x:Key="Caption">
            <Setter Property="Foreground" Value="{StaticResource Text.Secondary}"/>
            <Setter Property="FontSize" Value="11"/>
        </Style>
        <Style TargetType="Label">
            <Setter Property="Foreground" Value="{StaticResource Text.Primary}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Padding" Value="0,0,0,4"/>
        </Style>
        <Style TargetType="Button">
            <Setter Property="Padding" Value="16,6"/>
            <Setter Property="Margin" Value="8,0,0,0"/>
            <Setter Property="Background" Value="{StaticResource Surface.Raised}"/>
            <Setter Property="BorderBrush" Value="{StaticResource Border.Default}"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>
    </Window.Resources>

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0">
            <TextBlock Text="BK BIM TOOLS" Style="{StaticResource Caption}" FontWeight="SemiBold"/>
            <TextBlock Text="Exterior Wall Dimension" FontSize="18" FontWeight="SemiBold"
                       Foreground="{StaticResource Text.Primary}" Margin="0,2,0,4"/>
            <TextBlock Text="3 strings per wall (openings / perpendicular walls / overall), always facing outward. You'll pick the walls after clicking Run."
                       Style="{StaticResource Caption}" TextWrapping="Wrap"/>
        </StackPanel>

        <Separator Grid.Row="1" Margin="0,16,0,0"/>

        <!-- Dimension style -->
        <StackPanel Grid.Row="2" Margin="0,16,0,0">
            <Label Content="Dimension style"/>
            <ComboBox x:Name="DimensionStyleCombo" Height="28"/>
        </StackPanel>

        <!-- Offset spacing -->
        <StackPanel Grid.Row="3" Margin="0,12,0,0">
            <Label Content="Offset from wall (mm)"/>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="70"/>
                </Grid.ColumnDefinitions>
                <Slider x:Name="OffsetSlider" Grid.Column="0" Minimum="0" Maximum="3000"
                        VerticalAlignment="Center" Margin="0,0,12,0"/>
                <TextBox x:Name="OffsetTextBox" Grid.Column="1" Height="26"
                         VerticalContentAlignment="Center" TextAlignment="Right"/>
            </Grid>
        </StackPanel>

        <!-- Gap between the 3 exterior perimeter strings -->
        <StackPanel Grid.Row="4" Margin="0,12,0,0" VerticalAlignment="Top">
            <Label Content="Gap between the 3 perimeter strings (mm)"/>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="70"/>
                </Grid.ColumnDefinitions>
                <Slider x:Name="GapSlider" Grid.Column="0" Minimum="0" Maximum="3000"
                        VerticalAlignment="Center" Margin="0,0,12,0"/>
                <TextBox x:Name="GapTextBox" Grid.Column="1" Height="26"
                         VerticalContentAlignment="Center" TextAlignment="Right"/>
            </Grid>
        </StackPanel>

        <!-- Footer -->
        <StackPanel Grid.Row="5" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button x:Name="CancelButton" Content="Cancel" IsCancel="True"/>
            <Button x:Name="RunButton" Content="Run" IsDefault="True"
                    Background="{StaticResource Brand.Primary}" Foreground="White" BorderThickness="0"/>
        </StackPanel>
    </Grid>
</Window>
