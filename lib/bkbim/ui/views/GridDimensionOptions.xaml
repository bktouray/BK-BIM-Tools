<Window
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="BK BIM Tools - Grid Dimensions"
    Width="460"
    SizeToContent="Height"
    MinWidth="400" MinHeight="300"
    WindowStartupLocation="CenterScreen"
    ResizeMode="CanResizeWithGrip"
    Background="#FFFFFF"
    FontFamily="Segoe UI">

    <!-- Inline tokens for this first WPF window (UX_SPEC.md Sec 2). Migrate to a
         shared ui/themes/Tokens.xaml ResourceDictionary once a second window needs
         the same values (ADR-0002: framework by extraction, not speculation). -->
    <Window.Resources>
        <SolidColorBrush x:Key="Brand.Primary" Color="#1A56DB"/>
        <SolidColorBrush x:Key="Text.Primary" Color="#111417"/>
        <SolidColorBrush x:Key="Text.Secondary" Color="#5B6572"/>
        <SolidColorBrush x:Key="Surface.Raised" Color="#F7F8FA"/>
        <SolidColorBrush x:Key="Border.Default" Color="#DFE3E8"/>

        <Style TargetType="TextBlock" x:Key="Caption">
            <Setter Property="Foreground" Value="{StaticResource Text.Secondary}"/>
            <Setter Property="FontSize" Value="11"/>
        </Style>
        <Style TargetType="Label">
            <Setter Property="Foreground" Value="{StaticResource Text.Primary}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Padding" Value="0,0,0,4"/>
        </Style>
        <Style TargetType="Button">
            <Setter Property="Padding" Value="16,6"/>
            <Setter Property="Margin" Value="8,0,0,0"/>
            <Setter Property="Background" Value="{StaticResource Surface.Raised}"/>
            <Setter Property="BorderBrush" Value="{StaticResource Border.Default}"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>
    </Window.Resources>

    <!-- Single-Auto-row-per-block layout, spacing via margins only (no fixed-pixel
         spacer rows) - avoids the class of bug where a fixed-height row silently
         clipped real content (the Gap-to-overall control used to be cut off because
         its row was pinned to 20px instead of Auto). A trailing "*" row absorbs any
         extra space if the user resizes the window taller. -->
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0">
            <TextBlock Text="BK BIM TOOLS" Style="{StaticResource Caption}" FontWeight="SemiBold"/>
            <TextBlock Text="Grid Dimensions" FontSize="18" FontWeight="SemiBold"
                       Foreground="{StaticResource Text.Primary}" Margin="0,2,0,4"/>
            <TextBlock Text="Dimensions every grid detected in the current view with a grid-to-grid string and an overall string, on all sides."
                       Style="{StaticResource Caption}" TextWrapping="Wrap"/>
        </StackPanel>

        <Separator Grid.Row="1" Margin="0,16,0,0"/>

        <!-- Dimension style -->
        <StackPanel Grid.Row="2" Margin="0,16,0,0">
            <Label Content="Dimension style"/>
            <ComboBox x:Name="DimensionStyleCombo" Height="28"/>
        </StackPanel>

        <!-- Grid-to-grid spacing -->
        <StackPanel Grid.Row="3" Margin="0,12,0,0">
            <Label Content="Grid-to-grid spacing (mm)"/>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="70"/>
                </Grid.ColumnDefinitions>
                <Slider x:Name="OffsetSlider" Grid.Column="0" Minimum="0" Maximum="3000"
                        VerticalAlignment="Center" Margin="0,0,12,0"/>
                <TextBox x:Name="OffsetTextBox" Grid.Column="1" Height="26"
                         VerticalContentAlignment="Center" TextAlignment="Right"/>
            </Grid>
        </StackPanel>

        <!-- Gap to overall row -->
        <StackPanel Grid.Row="4" Margin="0,12,0,0">
            <Label Content="Gap to overall string (mm)"/>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="70"/>
                </Grid.ColumnDefinitions>
                <Slider x:Name="GapSlider" Grid.Column="0" Minimum="0" Maximum="3000"
                        VerticalAlignment="Center" Margin="0,0,12,0"/>
                <TextBox x:Name="GapTextBox" Grid.Column="1" Height="26"
                         VerticalContentAlignment="Center" TextAlignment="Right"/>
            </Grid>
        </StackPanel>

        <!-- Row 5 ("*") intentionally empty: absorbs extra vertical space so the
             footer stays anchored near the bottom instead of floating mid-window
             when the user resizes taller. -->

        <!-- Footer -->
        <StackPanel Grid.Row="6" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button x:Name="CancelButton" Content="Cancel" IsCancel="True"/>
            <Button x:Name="RunButton" Content="Run" IsDefault="True"
                    Background="{StaticResource Brand.Primary}" Foreground="White" BorderThickness="0"/>
        </StackPanel>
    </Grid>
</Window>
