<Window
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="BK BIM Tools"
    Width="460"
    SizeToContent="Height"
    MinWidth="400" MinHeight="260"
    WindowStartupLocation="CenterScreen"
    ResizeMode="CanResizeWithGrip"
    Background="{StaticResource Surface.Base}"
    FontFamily="Segoe UI">

    <!-- Branded replacement for BOQ Export's completion forms.alert(options=...).
         Color brushes come from the shared ui/themes/Tokens.xaml, merged in
         code-behind before this file is parsed - see bkbim/ui/tokens.py. -->
    <Window.Resources>
        <Style TargetType="TextBlock" x:Key="Caption">
            <Setter Property="Foreground" Value="{StaticResource Text.Secondary}"/>
            <Setter Property="FontSize" Value="11"/>
        </Style>
        <Style TargetType="Label">
            <Setter Property="Foreground" Value="{StaticResource Text.Primary}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Padding" Value="0,0,0,4"/>
        </Style>
        <Style x:Key="SecondaryButton" TargetType="Button">
            <Setter Property="Padding" Value="16,6"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
            <Setter Property="Background" Value="{StaticResource Surface.Raised}"/>
            <Setter Property="BorderBrush" Value="{StaticResource Border.Default}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Foreground" Value="{StaticResource Text.Primary}"/>
        </Style>
        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="Padding" Value="16,6"/>
            <Setter Property="Background" Value="{StaticResource Brand.Primary}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
        </Style>
        <Style x:Key="SummaryRow" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource Text.Primary}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Margin" Value="0,0,0,4"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
    </Window.Resources>

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0">
            <TextBlock Text="BK BIM TOOLS" Style="{StaticResource Caption}" FontWeight="SemiBold"/>
            <TextBlock x:Name="TitleText" FontSize="18" FontWeight="SemiBold"
                       Foreground="{StaticResource Text.Primary}" Margin="0,2,0,4"/>
        </StackPanel>

        <Separator Grid.Row="1" Margin="0,16,0,16"/>

        <!-- Saved path -->
        <StackPanel Grid.Row="2">
            <Label Content="Saved to"/>
            <TextBox x:Name="PathBox" IsReadOnly="True" Height="26"
                     Background="{StaticResource Surface.Raised}"
                     BorderBrush="{StaticResource Border.Default}" BorderThickness="1"
                     VerticalContentAlignment="Center" Padding="6,0"/>
        </StackPanel>

        <Separator Grid.Row="3" Margin="0,16,0,0"/>

        <!-- Summary heading -->
        <TextBlock x:Name="SummaryHeading" Text="Summary" Style="{StaticResource Caption}"
                    FontWeight="SemiBold" Grid.Row="4" Margin="0,16,0,8"/>

        <!-- Summary lines, added programmatically in code-behind -->
        <ScrollViewer Grid.Row="5" MaxHeight="220" VerticalScrollBarVisibility="Auto">
            <StackPanel x:Name="SummaryPanel"/>
        </ScrollViewer>

        <!-- Footer -->
        <StackPanel Grid.Row="6" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button x:Name="OpenFolderButton" Content="Open folder" Style="{StaticResource SecondaryButton}"/>
            <Button x:Name="DoneButton" Content="Done" IsDefault="True" IsCancel="True" Style="{StaticResource PrimaryButton}"/>
        </StackPanel>
    </Grid>
</Window>
