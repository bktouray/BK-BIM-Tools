<Window
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="BK BIM Tools Settings"
    Width="820" Height="620"
    MinWidth="700" MinHeight="480"
    WindowStartupLocation="CenterScreen"
    ResizeMode="CanResizeWithGrip"
    Background="{StaticResource Surface.Base}"
    FontFamily="Segoe UI">

    <!-- Color brushes come from the shared ui/themes/Tokens.xaml, merged in
         code-behind before this file is parsed - see bkbim/ui/tokens.py.
         First real implementation of UX_SPEC.md's shared-shell concept
         (Header/Nav/Content/Footer) - scoped to Settings' own footer actions
         (Restore Defaults/Import/Export/Cancel/Apply/OK) rather than the
         per-tool Run/Cancel/progress shell UX_SPEC also describes, which
         still doesn't exist as code and is out of scope here. -->
    <Window.Resources>
        <Style TargetType="TextBlock" x:Key="Caption">
            <Setter Property="Foreground" Value="{StaticResource Text.Secondary}"/>
            <Setter Property="FontSize" Value="11"/>
        </Style>

        <Style TargetType="Button" x:Key="FooterButton">
            <Setter Property="Padding" Value="16,6"/>
            <Setter Property="Margin" Value="8,0,0,0"/>
            <Setter Property="Background" Value="{StaticResource Surface.Raised}"/>
            <Setter Property="BorderBrush" Value="{StaticResource Border.Default}"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>

        <Style TargetType="Button" x:Key="NavButton">
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Padding" Value="12,8"/>
            <Setter Property="Margin" Value="0,0,0,2"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="{StaticResource Text.Primary}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="6">
                            <ContentPresenter Margin="{TemplateBinding Padding}" HorizontalAlignment="Left"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource Surface.Hover}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="Button" x:Key="NavButtonActive" BasedOn="{StaticResource NavButton}">
            <Setter Property="Background" Value="{StaticResource Surface.Hover}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>

        <Style TargetType="TextBlock" x:Key="NavCategoryHeader">
            <Setter Property="Foreground" Value="{StaticResource Text.Secondary}"/>
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="12,14,0,4"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Background="{StaticResource Surface.Raised}"
                BorderBrush="{StaticResource Border.Default}" BorderThickness="0,0,0,1" Padding="20,14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="260"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                    <TextBlock Text="BK BIM TOOLS" Style="{StaticResource Caption}" FontWeight="SemiBold"/>
                    <TextBlock Text="Settings" FontSize="20" FontWeight="SemiBold"
                               Foreground="{StaticResource Text.Primary}" Margin="0,2,0,0"/>
                </StackPanel>
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBox x:Name="SearchBox" Height="30" VerticalContentAlignment="Center" Padding="8,0"/>
                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                        <TextBlock Text="Workspace preset:" Style="{StaticResource Caption}"
                                   VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <ComboBox x:Name="WorkspacePresetCombo" Width="150" Height="24"/>
                    </StackPanel>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Body: nav + content -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="200"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Background="{StaticResource Surface.Raised}"
                    BorderBrush="{StaticResource Border.Default}" BorderThickness="0,0,1,0">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel x:Name="NavPanel" Margin="8,12,8,12"/>
                </ScrollViewer>
            </Border>

            <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="24">
                    <TextBlock x:Name="PageTitleText" FontSize="18" FontWeight="SemiBold"
                               Foreground="{StaticResource Text.Primary}"/>
                    <TextBlock x:Name="PageDescriptionText" Style="{StaticResource Caption}"
                               TextWrapping="Wrap" Margin="0,4,0,16"/>
                    <StackPanel x:Name="ContentPanel"/>
                </StackPanel>
            </ScrollViewer>
        </Grid>

        <!-- Footer -->
        <Border Grid.Row="2" Background="{StaticResource Surface.Raised}"
                BorderBrush="{StaticResource Border.Default}" BorderThickness="0,1,0,0" Padding="20,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Orientation="Horizontal">
                    <Button x:Name="RestoreDefaultsButton" Content="Restore Defaults" Style="{StaticResource FooterButton}" Margin="0,0,8,0"/>
                    <Button x:Name="ImportButton" Content="Import" Style="{StaticResource FooterButton}" Margin="0,0,8,0"/>
                    <Button x:Name="ExportButton" Content="Export" Style="{StaticResource FooterButton}"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button x:Name="CancelButton" Content="Cancel" IsCancel="True" Style="{StaticResource FooterButton}"/>
                    <Button x:Name="ApplyButton" Content="Apply" Style="{StaticResource FooterButton}"/>
                    <Button x:Name="OkButton" Content="OK" IsDefault="True" Style="{StaticResource FooterButton}"
                            Background="{StaticResource Brand.Primary}" Foreground="White" BorderThickness="0"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
